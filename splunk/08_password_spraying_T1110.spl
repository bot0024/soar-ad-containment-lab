index=win_security EventCode=4771 Failure_Code=0x18 NOT Account_Name="*$"
| eval user=lower(Account_Name), src_ip=replace(Client_Address,"^::ffff:","")
| bin _time span=10m
| stats dc(user) as users_targeted count as failures values(user) as targets min(_time) as first_seen by src_ip host _time
| where users_targeted>=5
| eval alert_name="Password Spraying",
       mitre_id="T1110.003",
       severity="high",
       user="multiple ("+users_targeted+" accounts)",
       service="Kerberos pre-auth",
       context=failures." failed logons across ".users_targeted." accounts from this IP in 10 min. Targets: ".mvjoin(targets,", "),
       event_time=strftime(first_seen,"%Y-%m-%d %H:%M:%S")
| table alert_name mitre_id severity user host src_ip service event_time context
